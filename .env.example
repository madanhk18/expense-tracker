# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Server-only. NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
# Used only for the "delete account" server action (auth.admin.deleteUser).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Used to build auth redirect/callback URLs (password reset, email confirmation).
# Set to your production URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
